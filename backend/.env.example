PORT=4000
JWT_SECRET=change_this_to_a_random_secret_string

# Demo mode simulates escrow funding, releases and payouts.
# No card is charged. Set to false only after wiring real payments.
DEMO_MODE=true

# Stripe Connect (optional, not wired into the milestone flow yet).
# The data model stores the 18% platform fee and 82% handyman payout
# separately, ready for PaymentIntents + application fees.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Google Sign-In (optional). Create an OAuth 2.0 Web client ID at
# https://console.cloud.google.com/apis/credentials and paste it here.
# Leave empty to show the demo "Continue with Google" button.
GOOGLE_CLIENT_ID=
